{
  "name": "lifequest",
  "private": true,
  "version": "0.10.1-beta.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "deploy": "node scripts/deploy.mjs",
    "apk": "node scripts/apk.mjs",
    "map": "node scripts/codemap.mjs",
    "check": "tsc --noEmit && vitest run --reporter=dot && node scripts/codemap.mjs",
    "release": "node scripts/release.mjs",
    "deploy:beta": "node scripts/deploy.mjs --beta",
    "promote": "node scripts/promote.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome-team/capacitor-file-opener": "^8.0.5",
    "@capgo/capacitor-updater": "^8.52.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "nativeVersion": "0.9.0"
}
